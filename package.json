{
  "name": "autoexif",
  "version": "2.0.2",
  "description": "CLI tool for removing excess EXIF data from images",
  "main": "dist/index.js",
  "bin": {
    "autoexif": "dist/index.js"
  },
  "scripts": {
    "dev": "tsup src/index.ts --watch",
    "build": "tsup src/index.ts --format cjs --dts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "exif",
    "data",
    "simple",
    "image",
    "photo",
    "metadata",
    "exiftool",
    "cli",
    "remove",
    "auto",
    "automatic"
  ],
  "author": "Cyprian Zdebski <shipurjan@gmail.com>",
  "homepage": "https://github.com/shipurjan/autoexif#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shipurjan/autoexif.git"
  },
  "bugs": {
    "url": "https://github.com/shipurjan/autoexif/issues",
    "email": "shipurjan@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "24",
    "prettier": "3.10.0",
    "tsup": "9.0.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "commander": "15.1.0",
    "exiftool-vendored": "39.2.0"
  },
  "engines": {
    "node": ">=24"
  }
}
